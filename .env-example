DB_CONNECTION=<your MongoDB URI, e.g. mongodb://127.0.0.1:27017/ex_mark1>
JWT_SECRET=<your JWT secret key, use a long random string>

STRIPE_SECRET_KEY=<your Stripe secret key from dashboard>

EMAIL_HOST=<your SMTP host, e.g. smtp.gmail.com>
EMAIL_PORT=<your SMTP port, e.g. 587>
EMAIL_SECURE=<true if SSL, false if using TLS>
EMAIL_USER=<your SMTP email address, e.g. no-reply@example.com>
EMAIL_PASS=<your app-specific SMTP password (not your email login)>

APP_BASE_URL=http://localhost:5000

# OAuth (not used yet as of July 13, 2025)
GOOGLE_CLIENT_ID=<Google OAuth client ID>
GOOGLE_CLIENT_SECRET=<Google OAuth client secret>

